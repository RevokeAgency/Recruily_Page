          user_id: string
          organisation_id: string
          role?: string
        }
        Update: {
          user_id?: string
          organisation_id?: string
          role?: string
        }
      }
      candidates: {
        Row: {
          id: string
          organisation_id: string
          first_name: string
          last_name: string
          email: string | null
          phone: string | null
          location: string | null
          status: string
          notes: string | null
          created_by: string | null
          created_at: string
          updated_at: string

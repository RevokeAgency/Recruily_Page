          location?: string | null
          job_type?: string | null
          salary_range?: string | null
          status?: string
          created_by?: string | null
          created_at?: string
          updated_at?: string
        }
      }
      job_candidate_matches: {
        Row: {
          id: string
          job_id: string
          candidate_id: string
          match_score: number | null
          match_details: Json | null
          status: string
          created_at: string
          updated_at: string
        }
        Insert: {
          id?: string
          job_id: string
          candidate_id: string
          match_score?: number | null
          match_details?: Json | null
          status?: string
          created_at?: string
          updated_at?: string
        }
        Update: {

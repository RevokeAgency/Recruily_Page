# ============================================================
# Recruily — Required Environment Variables
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.
# ============================================================

# ----------------------------
# SUPABASE (required)
# From: https://supabase.com/dashboard → Project Settings → API
# ----------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ----------------------------
# GOOGLE GEMINI AI (required)
# From: https://aistudio.google.com/app/apikey
# Both variable names are checked; GOOGLE_GENERATIVE_AI_API_KEY takes priority.
# ----------------------------
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
# GEMINI_API_KEY=your_gemini_api_key   # Alternative name, same key

# ----------------------------
# APPLICATION (required)
# ----------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------
# EMAIL / SMTP (required for candidate invitations and signup confirmation)
# Supports any SMTP provider (SendGrid, Resend, Postmark, Gmail, etc.)
# ----------------------------
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@yourcompany.com

# ----------------------------
# OPTIONAL
# ----------------------------
# Google Analytics
NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# File upload limits
NEXT_PUBLIC_MAX_FILE_SIZE=10
NEXT_PUBLIC_ALLOWED_FILE_TYPES=.pdf,.doc,.docx

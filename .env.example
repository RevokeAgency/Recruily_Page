# Recruily_Page Environment Configuration
# Copy this file to .env.local and fill in your actual values

# ======================
# SUPABASE CONFIGURATION
# ======================
# Get these from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ======================
# GOOGLE AI CONFIGURATION
# ======================
# Get your API key from Google AI Studio
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# ======================
# NEXT.JS CONFIGURATION
# ======================
# For production deployment
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# ======================
# APPLICATION SETTINGS
# ======================
# App environment (development, staging, production)
NODE_ENV=development

# Application base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ======================
# FILE UPLOAD SETTINGS
# ======================
# Maximum file size for CV uploads (in MB)
NEXT_PUBLIC_MAX_FILE_SIZE=10

# Allowed file types for CV uploads
NEXT_PUBLIC_ALLOWED_FILE_TYPES=.pdf,.doc,.docx

# ======================
# EMAIL CONFIGURATION (Optional)
# ======================
# For email notifications and invitations
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@yourcompany.com

# ======================
# ANALYTICS (Optional)
# ======================
# Google Analytics tracking ID
NEXT_PUBLIC_GA_TRACKING_ID=GA_TRACKING_ID

# ======================
# FEATURE FLAGS (Optional)
# ======================
# Enable/disable specific features
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_ONBOARDING=true
NEXT_PUBLIC_ENABLE_BULK_ACTIONS=true